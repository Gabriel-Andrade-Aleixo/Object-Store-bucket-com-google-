<%- include('../partials/header', { title: 'Objetos do bucket' }) %><section class="hero"><div><span class="eyebrow">Google Cloud Storage</span><h1>Objetos do bucket</h1><p><%= bucket.name %> · <%= bucket.location %> · <%= bucket.storageClass %></p></div><b><%= objects.length %> objeto(s)</b></section>
<section class="panel table-wrap"><table><thead><tr><th>Objeto</th><th>Tipo</th><th>Tamanho</th><th>Atualizado</th><th>URL pública</th></tr></thead><tbody><% objects.forEach((object) => { %><tr><td><code><%= object.name %></code></td><td><%= object.contentType %></td><td><%= fileSize(object.size) %></td><td><%= dateTime(object.updated) %></td><td><a href="<%= object.publicUrl %>" target="_blank" rel="noreferrer">Abrir ↗</a></td></tr><% }) %></tbody></table></section>
<%- include('../partials/footer') %>
