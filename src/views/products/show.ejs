<%- include('../partials/header', { title: product.name }) %><% if (ok) { %><div class="alert success"><%= ok %></div><% } %>
<% const primary = product.images.find((image) => image.is_primary) || product.images[0]; %>
<section class="detail"><div class="cover"><% if (primary) { %><img src="<%= primary.public_url %>" alt="Imagem principal de <%= product.name %>"><span>Capa</span><% } else { %><b>Envie a primeira imagem</b><% } %></div><div><span class="eyebrow">Produto</span><h1><%= product.name %></h1><div class="price"><%= currency(product.price) %></div><p><%= product.description %></p><small><%= product.images.length %> imagem(ns) · cadastrado em <%= dateTime(product.created_at) %></small></div></section>
<section class="heading"><div><span class="eyebrow">Google Cloud Storage</span><h2>Adicionar imagens</h2></div></section>
<form class="panel upload" action="/products/<%= product.id %>/images" method="post" enctype="multipart/form-data"><label>Selecione até 10 imagens<input type="file" name="images" accept="image/*" multiple required><small>JPG, PNG, WebP, GIF ou SVG · até 10 MB cada</small></label><label class="check"><input type="checkbox" name="makeFirstPrimary"> Usar a primeira como capa</label><div id="image-preview" class="image-preview" aria-live="polite"></div><button class="button primary" type="submit">Enviar ao bucket</button></form>
<section class="heading"><div><span class="eyebrow">Galeria</span><h2>Todas as imagens</h2></div><b><%= product.images.length %> arquivo(s)</b></section>
<section class="gallery"><% product.images.forEach((image) => { %><article class="gallery-card <%= image.is_primary ? 'is-primary' : '' %>"><a href="<%= image.public_url %>" target="_blank" rel="noreferrer"><img src="<%= image.public_url %>" alt="<%= image.original_name %>"></a><div><% if (image.is_primary) { %><span class="tag">Capa</span><% } %><strong><%= image.original_name %></strong><small><%= dateTime(image.created_at) %></small></div><footer><a class="button tiny secondary" href="/products/<%= product.id %>/images/<%= image.id %>/download">Baixar</a><% if (!image.is_primary) { %><form action="/products/<%= product.id %>/images/<%= image.id %>/primary" method="post"><button class="button tiny secondary">Definir capa</button></form><% } %><form action="/products/<%= product.id %>/images/<%= image.id %>/delete" method="post" onsubmit="return confirm('Apagar esta imagem?')"><button class="button tiny danger">Apagar</button></form></footer></article><% }) %></section>
<script src="/image-preview.js" defer></script>
<%- include('../partials/footer') %>
