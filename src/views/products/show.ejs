<%- include('../partials/header', { title: product.name }) %>

<% if (ok) { %><div class="alert success"><%= ok %></div><% } %>
<% const primary = product.images.find((image) => image.is_primary) || product.images[0]; %>

<a class="back-link" href="/products">← Voltar ao catálogo</a>

<section class="detail">
  <div class="cover">
    <% if (primary) { %>
      <img src="<%= primary.public_url %>" alt="Imagem principal de <%= product.name %>">
      <span class="cover-tag">Imagem principal</span>
    <% } else { %>
      <span class="image-placeholder">Envie a primeira imagem</span>
    <% } %>
  </div>
  <div class="detail-copy">
    <span class="eyebrow">Produto</span>
    <h1><%= product.name %></h1>
    <div class="price"><%= currency(product.price) %></div>
    <p><%= product.description %></p>
    <div class="detail-meta">
      <div><strong><%= product.images.length %></strong><span>imagens</span></div>
      <div><strong><%= dateTime(product.created_at) %></strong><span>cadastrado em</span></div>
    </div>
  </div>
</section>

<section class="heading"><div><span class="eyebrow">Google Cloud Storage</span><h2>Adicionar imagens</h2></div></section>
<form class="panel upload" action="/products/<%= product.id %>/images" method="post" enctype="multipart/form-data">
  <label class="upload-field"><span>Selecione até 10 imagens</span><small>JPG, PNG, WebP, GIF ou SVG · até 10 MB por arquivo</small><input type="file" name="images" accept="image/*" multiple required></label>
  <label class="check"><input type="checkbox" name="makeFirstPrimary"> Usar a primeira como capa</label>
  <div id="image-preview" class="image-preview" aria-live="polite"></div>
  <button class="button primary" type="submit">Enviar ao bucket</button>
</form>

<section class="heading"><div><span class="eyebrow">Galeria</span><h2>Todas as imagens</h2></div><span class="result-pill"><%= product.images.length %> arquivo(s)</span></section>
<section class="gallery">
  <% product.images.forEach((image) => { %>
    <article class="gallery-card <%= image.is_primary ? 'is-primary' : '' %>">
      <a class="gallery-image" href="<%= image.public_url %>" target="_blank" rel="noreferrer"><img loading="lazy" src="<%= image.public_url %>" alt="<%= image.original_name %>"></a>
      <div class="gallery-info"><% if (image.is_primary) { %><span class="tag">Capa</span><% } %><strong title="<%= image.original_name %>"><%= image.original_name %></strong><small><%= dateTime(image.created_at) %></small></div>
      <footer class="gallery-actions">
        <a class="button tiny secondary" href="/products/<%= product.id %>/images/<%= image.id %>/download">Baixar</a>
        <% if (!image.is_primary) { %><form action="/products/<%= product.id %>/images/<%= image.id %>/primary" method="post"><button class="button tiny secondary" type="submit">Definir capa</button></form><% } %>
        <form action="/products/<%= product.id %>/images/<%= image.id %>/delete" method="post" onsubmit="return confirm('Apagar esta imagem?')"><button class="button tiny danger" type="submit">Apagar</button></form>
      </footer>
    </article>
  <% }) %>
</section>

<script src="/image-preview.js" defer></script>
<%- include('../partials/footer') %>
