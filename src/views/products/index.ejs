<%- include('../partials/header', { title: 'Produtos' }) %>
<section class="hero"><div><span class="eyebrow">Object Store</span><h1>Catálogo de produtos</h1><p>Dados no PostgreSQL local e imagens públicas no bucket do grupo C.</p></div><a class="button primary" href="/products/new">Cadastrar produto</a></section>
<% if (!products.length) { %><section class="empty"><h2>Nenhum produto cadastrado</h2><p>Cadastre manualmente ou execute a carga de demonstração.</p></section><% } else { %>
<section class="catalog-grid"><% products.forEach((product) => { %><article class="card"><a class="card-image" href="/products/<%= product.id %>"><% if (product.primary_image_url) { %><img src="<%= product.primary_image_url %>" alt="Capa de <%= product.name %>"><% } else { %><span>Sem imagem</span><% } %></a><div class="card-content"><small><%= product.image_count %> imagem(ns)</small><h2><a href="/products/<%= product.id %>"><%= product.name %></a></h2><p><%= product.description %></p><div class="card-footer"><strong><%= currency(product.price) %></strong><a href="/products/<%= product.id %>">Ver detalhes →</a></div></div></article><% }) %></section><% } %>
<%- include('../partials/footer') %>
