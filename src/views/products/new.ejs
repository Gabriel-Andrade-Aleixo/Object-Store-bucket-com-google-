<%- include('../partials/header', { title: 'Novo produto' }) %>

<a class="back-link" href="/products">← Voltar ao catálogo</a>
<section class="form-layout">
  <div class="form-intro">
    <span class="eyebrow">Cadastro</span>
    <h1>Novo produto</h1>
    <p>Os dados serão gravados no PostgreSQL local. Depois, você poderá enviar as imagens ao bucket.</p>
    <div class="info-card"><strong>Padronização automática</strong><p>O nome será salvo em formato de título, como “Câmera de Ação 3D”.</p></div>
  </div>
  <form class="panel form-panel" action="/products" method="post">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <label>Nome<input name="name" required minlength="2" maxlength="120" value="<%= values.name || '' %>" placeholder="Ex.: câmera de ação 3D"></label>
    <label>Descrição<textarea name="description" required minlength="5" maxlength="2000" rows="6" placeholder="Descreva as principais características"><%= values.description || '' %></textarea></label>
    <label>Preço (R$)<input name="price" required inputmode="decimal" value="<%= values.price || '' %>" placeholder="1999,90"></label>
    <div class="actions"><a class="button secondary" href="/products">Cancelar</a><button class="button primary" type="submit">Salvar produto</button></div>
  </form>
</section>

<%- include('../partials/footer') %>
