<%- include('../partials/header', { title: 'Novo produto' }) %>
<section class="form-layout"><div><span class="eyebrow">Cadastro</span><h1>Novo produto</h1><p>Os dados serão gravados no PostgreSQL local. Depois, envie as imagens ao bucket.</p></div>
<form class="panel form-panel" action="/products" method="post"><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<label>Nome<input name="name" required minlength="2" maxlength="120" value="<%= values.name || '' %>"></label>
<label>Descrição<textarea name="description" required minlength="5" maxlength="2000" rows="6"><%= values.description || '' %></textarea></label>
<label>Preço (R$)<input name="price" required inputmode="decimal" value="<%= values.price || '' %>" placeholder="1999,90"></label>
<div class="actions"><a class="button secondary" href="/products">Cancelar</a><button class="button primary" type="submit">Salvar produto</button></div></form></section>
<%- include('../partials/footer') %>
